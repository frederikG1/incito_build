# Kopiér til `.env` og læg din nøgle i den.
#   cp .env.example .env
#
# Hent en nøgle på https://console.anthropic.com/settings/keys
# `.env` er gitignored — nøglen forlader ikke din maskine.
ANTHROPIC_API_KEY=sk-ant-...

# Kun til `npm run decorate` (stemningsbilleder). Nøgle: https://ai.dev
# Billedmodellerne kræver fakturering på Google-projektet — uden den
# svarer de 429 med `limit: 0`. `npm run decorate -- --dry` virker uden.
GEMINI_API_KEY=

# Valgfrit
# INCITIO_MODEL=claude-opus-5
# PORT=8787
