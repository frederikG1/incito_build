# Kopiér til `.env` og læg din nøgle i den.
#   cp .env.example .env
#
# Hent en nøgle på https://console.anthropic.com/settings/keys
# `.env` er gitignored — nøglen forlader ikke din maskine.
ANTHROPIC_API_KEY=sk-ant-...

# Kun til `npm run decorate` (stemningsbilleder). Nøgle: https://ai.dev
# Billedmodellerne kræver fakturering på Google-projektet — uden den
# svarer de 429 med `limit: 0`. `npm run decorate -- --dry` virker uden.
GEMINI_API_KEY=

# Billedmodellen. Sat her frem for i koden, fordi udbuddet og
# gratis-niveauet flytter sig oftere end denne pipeline gør.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Valgfrit
# INCITIO_MODEL=claude-opus-5
# PORT=8787

# En avis at teste med. Forudfylder linkfeltet i studioet, så den ikke
# skal findes frem hver gang. Signaturen i ?s= er adgangen til
# udgivelsen, så den hører hjemme her og ikke i koden.
INCITIO_TEST_PUBLICATION=
