{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditOps",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "description": "Swap two offers.",
        "type": "object",
        "properties": {
          "op": {
            "const": "swap"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "withOfferId": {
            "description": "A placed offer trades places; a reserve offer takes this one's slot and this one goes to reserve.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "offerId",
          "withOfferId"
        ]
      },
      {
        "description": "Put an offer in a slot. The slot's occupant moves to where the offer was, or to reserve.",
        "type": "object",
        "properties": {
          "op": {
            "const": "place"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "slotId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "offerId",
          "pageId",
          "slotId"
        ]
      },
      {
        "description": "Put an offer on a page, in its first empty slot — or, on a full page, in the chain's layout with one more slot.",
        "type": "object",
        "properties": {
          "op": {
            "const": "add"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "offerId",
          "pageId"
        ]
      },
      {
        "description": "Take an offer off its page, into reserve.",
        "type": "object",
        "properties": {
          "op": {
            "const": "remove"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "offerId"
        ]
      },
      {
        "description": "Make an offer its page's lead: move it into the page's biggest slot.",
        "type": "object",
        "properties": {
          "op": {
            "const": "lead"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "offerId"
        ]
      },
      {
        "description": "Rewrite a line of a tile.",
        "type": "object",
        "properties": {
          "op": {
            "const": "text"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "part": {
            "enum": [
              "name",
              "description",
              "brand",
              "quantity",
              "meta"
            ]
          },
          "text": {
            "description": "The words to print; \"\" removes the line; null goes back to the feed's.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "offerId",
          "part",
          "text"
        ]
      },
      {
        "description": "Move, size or hide one box of a tile. media: offsets ±1 of its frame, scale 0.5–2; others: offsets ±25 page %, scale 0.4–3.",
        "type": "object",
        "properties": {
          "op": {
            "const": "part"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "part": {
            "enum": [
              "media",
              "price",
              "marks",
              "brand",
              "name",
              "quantity",
              "description",
              "meta",
              "tags"
            ]
          },
          "offsetX": {
            "type": "number"
          },
          "offsetY": {
            "type": "number"
          },
          "scale": {
            "type": "number"
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "required": [
          "op",
          "offerId",
          "part"
        ]
      },
      {
        "description": "How a several-product tile stands its products: row, stagger, grid or fan; null lets the page decide.",
        "type": "object",
        "properties": {
          "op": {
            "const": "arrange"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "arrangement": {
            "anyOf": [
              {
                "enum": [
                  "row",
                  "stagger",
                  "grid",
                  "fan"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "offerId",
          "arrangement"
        ]
      },
      {
        "description": "Move, size, turn, restack or hide one product inside a several-product tile. Offsets ±100 page %, scale 0.2–3, rotate ±180°, depth −4 (back) to 4 (front).",
        "type": "object",
        "properties": {
          "op": {
            "const": "pack"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "description": "Which product of the cluster, 0 first, as the offer lists them.",
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "offsetX": {
            "type": "number"
          },
          "offsetY": {
            "type": "number"
          },
          "scale": {
            "type": "number"
          },
          "rotate": {
            "type": "number"
          },
          "depth": {
            "type": "integer"
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "required": [
          "op",
          "offerId",
          "index"
        ]
      },
      {
        "description": "Develop a tile's photograph: exposure (stops ±3), brightness/contrast/saturation/lightness (±1), hue (±180°), levels, curves, sharpen (0–3), blur (0–0.05 of width), edges, blend mode, skew (±45°), crop and mask. Never changes the image file.",
        "type": "object",
        "properties": {
          "op": {
            "const": "adjust"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "adjust": {
            "description": "Merged over what is there; a key set to null-ish (0, false, \"normal\") is removed. null clears everything.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "exposure": {
                    "type": "number",
                    "minimum": -3,
                    "maximum": 3
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "levels": {
                    "type": "object",
                    "properties": {
                      "black": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0
                      },
                      "white": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 1
                      },
                      "gamma": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 9.99,
                        "default": 1
                      },
                      "outBlack": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0
                      },
                      "outWhite": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 1
                      }
                    },
                    "required": [
                      "black",
                      "white",
                      "gamma",
                      "outBlack",
                      "outWhite"
                    ]
                  },
                  "curves": {
                    "type": "object",
                    "properties": {
                      "rgb": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      },
                      "r": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      },
                      "g": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      },
                      "b": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      }
                    },
                    "required": []
                  },
                  "hue": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "lightness": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "sharpen": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "blur": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.05
                  },
                  "edges": {
                    "type": "boolean"
                  },
                  "blend": {
                    "enum": [
                      "normal",
                      "multiply",
                      "screen",
                      "overlay",
                      "darken",
                      "lighten",
                      "color-dodge",
                      "color-burn",
                      "hard-light",
                      "soft-light",
                      "difference",
                      "exclusion",
                      "hue",
                      "saturation",
                      "color",
                      "luminosity"
                    ]
                  },
                  "skewX": {
                    "type": "number",
                    "minimum": -45,
                    "maximum": 45
                  },
                  "skewY": {
                    "type": "number",
                    "minimum": -45,
                    "maximum": 45
                  },
                  "crop": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 1
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ]
                  },
                  "mask": {
                    "type": "object",
                    "properties": {
                      "w": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "h": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60000
                      },
                      "feather": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.2,
                        "default": 0
                      },
                      "invert": {
                        "type": "boolean",
                        "default": false
                      }
                    },
                    "required": [
                      "w",
                      "h",
                      "path",
                      "feather",
                      "invert"
                    ]
                  }
                },
                "required": []
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "offerId",
          "adjust"
        ]
      },
      {
        "description": "Develop a picture on the page, as `adjust` does a tile's.",
        "type": "object",
        "properties": {
          "op": {
            "const": "adjustDecor"
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "decorId": {
            "type": "string",
            "minLength": 1
          },
          "adjust": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "exposure": {
                    "type": "number",
                    "minimum": -3,
                    "maximum": 3
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "levels": {
                    "type": "object",
                    "properties": {
                      "black": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0
                      },
                      "white": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 1
                      },
                      "gamma": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 9.99,
                        "default": 1
                      },
                      "outBlack": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0
                      },
                      "outWhite": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 1
                      }
                    },
                    "required": [
                      "black",
                      "white",
                      "gamma",
                      "outBlack",
                      "outWhite"
                    ]
                  },
                  "curves": {
                    "type": "object",
                    "properties": {
                      "rgb": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      },
                      "r": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      },
                      "g": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      },
                      "b": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 16
                      }
                    },
                    "required": []
                  },
                  "hue": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "lightness": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "sharpen": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "blur": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.05
                  },
                  "edges": {
                    "type": "boolean"
                  },
                  "blend": {
                    "enum": [
                      "normal",
                      "multiply",
                      "screen",
                      "overlay",
                      "darken",
                      "lighten",
                      "color-dodge",
                      "color-burn",
                      "hard-light",
                      "soft-light",
                      "difference",
                      "exclusion",
                      "hue",
                      "saturation",
                      "color",
                      "luminosity"
                    ]
                  },
                  "skewX": {
                    "type": "number",
                    "minimum": -45,
                    "maximum": 45
                  },
                  "skewY": {
                    "type": "number",
                    "minimum": -45,
                    "maximum": 45
                  },
                  "crop": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 1
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ]
                  },
                  "mask": {
                    "type": "object",
                    "properties": {
                      "w": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "h": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60000
                      },
                      "feather": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.2,
                        "default": 0
                      },
                      "invert": {
                        "type": "boolean",
                        "default": false
                      }
                    },
                    "required": [
                      "w",
                      "h",
                      "path",
                      "feather",
                      "invert"
                    ]
                  }
                },
                "required": []
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "pageId",
          "decorId",
          "adjust"
        ]
      },
      {
        "description": "Lock a tile in its slot: a new week and a re-layout leave it where it is.",
        "type": "object",
        "properties": {
          "op": {
            "const": "pin"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "op",
          "offerId",
          "pinned"
        ]
      },
      {
        "description": "Correct an offer's price or previous price.",
        "type": "object",
        "properties": {
          "op": {
            "const": "price"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "prePrice": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "offerId"
        ]
      },
      {
        "description": "Rewrite a page's heading.",
        "type": "object",
        "properties": {
          "op": {
            "const": "pageText"
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "subtitle": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "op",
          "pageId"
        ]
      },
      {
        "description": "Give a page another of the chain's layouts. Offers keep their order; what does not fit goes to reserve.",
        "type": "object",
        "properties": {
          "op": {
            "const": "layout"
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "pageId",
          "templateId"
        ]
      },
      {
        "description": "Move a page to position `to` (0 is the front page).",
        "type": "object",
        "properties": {
          "op": {
            "const": "movePage"
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "op",
          "pageId",
          "to"
        ]
      },
      {
        "description": "Leave a page out of this edition — the national cover in a store's copy, a store page in the national one. Its offers go to reserve.",
        "type": "object",
        "properties": {
          "op": {
            "const": "removePage"
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "pageId"
        ]
      },
      {
        "description": "Undo every tweak on a tile — boxes, picture, wording — but keep it pinned if it was.",
        "type": "object",
        "properties": {
          "op": {
            "const": "reset"
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "offerId"
        ]
      }
    ]
  },
  "maxItems": 200
}
